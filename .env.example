PORT=3000
# SMTP settings for nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@yourdomain.com

# OTP settings
OTP_EXPIRES_MIN=15
OTP_PEPPER=some-secret-pepper-string
MONGO_URI=mongodb://localhost:27017/aviaire
FRONTEND_ORIGINS=https://aviaire.vercel.app,https://localhost:5173
