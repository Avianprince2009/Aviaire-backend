PORT=3000
# JWT secret used for user authentication and admin access.
APP_TOKEN=replace-with-a-strong-secret

# SMTP settings for nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@yourdomain.com

# OTP settings
OTP_EXPIRES_MIN=15
OTP_PEPPER=some-secret-pepper-string

# Database
MONGO_URI=mongodb://localhost:27017/aviaire

# Paystack configuration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Allowed frontend origins for CORS
FRONTEND_ORIGINS=https://aviaire.vercel.app,http://localhost:5173,http://localhost:4173

# Deployment environment
NODE_ENV=development
